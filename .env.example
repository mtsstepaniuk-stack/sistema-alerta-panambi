# Render define PORT automáticamente. Para desarrollo local no hace falta configurar nada.
# PORT=3000

# Opcional: usar estas variables si se monta almacenamiento persistente.
# SAT_DATA_DIR=/var/data/database
# SAT_UPLOAD_DIR=/var/data/uploads/incidencias

# Seguridad de formularios vecinales (Cloudflare Turnstile).
# Crear un widget para el dominio desplegado y configurar ambas variables en Render.
# TURNSTILE_SITE_KEY=...
# TURNSTILE_SECRET_KEY=...
